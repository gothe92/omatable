def load_omarchy_theme() -> Dict[str, str]:
    palette = {
        "background": "#1a1b26",
        "dark_background": "#16161e",
        "darker_background": "#101014",
        "lighter_background": "#24283b",
        "foreground": "#c0caf5",
        "dark_foreground": "#565f89",
        "bright_foreground": "#ffffff",
        "selection_background": "#33467c",
        "selection_foreground": "#c0caf5",
        "blue": "#7aa2f7",
        "cyan": "#7dcfff",
        "green": "#9ece6a",
        "yellow": "#e0af68",
        "red": "#f7768e",
        "magenta": "#bb9af7",
        "muted": "#565f89",
    }
    try:
        out = subprocess.check_output(
            ["omarchy-theme-color", "--all"], stderr=subprocess.DEVNULL, text=True
        )
        for line in out.splitlines():
            if "\t" in line:
                k, v = line.split("\t", 1)
                if v.startswith("#"):
                    palette[k.strip()] = v.strip()
    except Exception:
        pass
    return palette


def load_hypr_rounding() -> int:
    """Corner radius used by the Omarchy shell: Hyprland's decoration:rounding."""
    try:
        out = subprocess.check_output(
            ["hyprctl", "-j", "getoption", "decoration:rounding"], stderr=subprocess.DEVNULL, text=True, timeout=2
        )
        return max(0, int(json.loads(out).get("int", 0)))
    except Exception:
        return 0


def load_omarchy_font() -> str:
    try:
        out = subprocess.check_output(
            ["omarchy-font-current"], stderr=subprocess.DEVNULL, text=True
        ).strip()
        if out:
            return out
    except Exception:
        pass
    return "JetBrainsMono Nerd Font"


