    # Loader & Async Execution Engine
    # -----------------------------------------------------------------------

    def _tick_spinner(self):
        if not self._active_workers:
            self._spinner_timer.stop()
            if self.status_bar.currentMessage()[:1] in self.SPINNER_FRAMES:
                self.status_bar.clearMessage()
            return
        self._spinner_idx = (self._spinner_idx + 1) % len(self.SPINNER_FRAMES)
        frame = self.SPINNER_FRAMES[self._spinner_idx]
        self.status_bar.showMessage(f"{frame}  {self._loading_label}")

    def _set_loading(self, active: bool, label: str = "Loading..."):
        if active:
            self._loading_label = label
            frame = self.SPINNER_FRAMES[self._spinner_idx]
            self.status_bar.showMessage(f"{frame}  {label}")
            if not self._spinner_timer.isActive():
                self._spinner_timer.start()
        elif not self._active_workers:
            self._spinner_timer.stop()
            # Don't leave a finished task's spinner text behind
            if self.status_bar.currentMessage()[:1] in self.SPINNER_FRAMES:
                self.status_bar.clearMessage()

    def _run_async(self, label: str, fn: Callable[[], Any], on_done: Callable[[Any], None],
                   channel: Optional[str] = None, on_error: Optional[Callable[[str], None]] = None):
        """Run fn off the UI thread. Within a channel only the newest request's result is
        applied, so e.g. a slow table load can't overwrite a newer one; requests on
        different channels (or with no channel) never cancel each other."""
        # In headless unit tests when window is not shown, run synchronously
        if not self.isVisible():
            self._set_loading(True, label)
            try:
                res = fn()
            except Exception as exc:
                self._set_loading(False)
                if on_error is None:
                    raise
                on_error(str(exc))
                return
            try:
                on_done(res)
            finally:
                self._set_loading(False)
            return

        self._req_counter += 1
        req_id = self._req_counter
        if channel:
            self._channel_latest[channel] = req_id
        self._set_loading(True, label)

        worker = AsyncDbWorker(req_id, fn, self)
        self._active_workers[req_id] = worker

        def _handle_ok(r_id: int, result: Any):
            self._active_workers.pop(r_id, None)
            self._set_loading(False)
            # Only apply if this is the latest request or no newer request superseded it
            if not channel or self._channel_latest.get(channel) == r_id:
                try:
                    on_done(result)
                except Exception as exc:
                    self.status_bar.showMessage(f"Error: {exc}")

        def _handle_err(r_id: int, err_msg: str):
            self._active_workers.pop(r_id, None)
            self._set_loading(False)
            self.status_bar.showMessage(f"Error: {err_msg}")
            if on_error:
                try:
                    on_error(err_msg)
                except Exception as exc:
                    self.status_bar.showMessage(f"Error: {exc}")

        def _handle_finished():
            # Only release the QThread once run() has fully returned; deleting it
            # from the result signal aborts the process ("Destroyed while thread is still running")
            self._alive_threads.discard(worker)
            worker.deleteLater()

        worker.succeeded.connect(_handle_ok)
        worker.failed.connect(_handle_err)
        worker.finished.connect(_handle_finished)
        self._alive_threads.add(worker)
        worker.start()

    def closeEvent(self, event):
        for worker in list(self._alive_threads):
            worker.wait(15000)
        super().closeEvent(event)

    # -----------------------------------------------------------------------
    # Actions & Event Handlers
    # -----------------------------------------------------------------------

    def refresh_containers(self):
        if self.sqlite_path:
            self.containers = [self.backend.sqlite_file(self.sqlite_path)]
            c = self.containers[0]
            self.container_list.blockSignals(True)
            self.container_list.clear()
            self.container_list.addItem(f"{c.name}\n{c.engine_label} {c.version}")
            self.container_list.setCurrentRow(0)
            self.container_list.blockSignals(False)
            self.on_container_selected(0)
            return

        prev_name = self.current_container.name if self.current_container else self.initial_container
        self.initial_container = ""

        def _task():
            return self.backend.discover_containers()

        def _done(discovered: List[DockerDbContainer]):
            self.containers = discovered
            self.container_list.blockSignals(True)
            self.container_list.clear()

            selected_idx = 0
            for idx, c in enumerate(self.containers):
                label = f"{c.name}\n{c.engine_label} {c.version}".rstrip()
                item = QListWidgetItem(label)
                if not c.running:
                    item.setForeground(QColor(self.theme["muted"]))
                self.container_list.addItem(item)
                if prev_name and c.name == prev_name:
                    selected_idx = idx

            self.container_list.blockSignals(False)
            if self.containers:
                self.container_list.blockSignals(True)
                self.container_list.setCurrentRow(selected_idx)
                self.container_list.blockSignals(False)
                self.on_container_selected(selected_idx)
            else:
                self.current_container = None
                self._clear_tree()
                err = self.backend.docker_error
                if err:
                    hint = " — add your user to the docker group" if "permission denied" in err.lower() else ""
                    msg = err if err.startswith("Docker ") else f"Can't reach Docker: {err}"
                    self.status_bar.showMessage(f"{msg}{hint}")
                else:
                    self.status_bar.showMessage("No database containers")

        self._run_async("Scanning Docker containers...", _task, _done, channel="containers")

    def on_container_selected(self, row: int):
        if row < 0 or row >= len(self.containers):
            return
        c = self.containers[row]
        prev = self.current_container
        if prev is not c:
            # Each container keeps its own query; results never carry over
            self._channel_latest.pop("query", None)
            if prev is not None:
                self._queries[prev.name] = self.query_editor.toPlainText()
            self.query_editor.setPlainText(self._queries.get(c.name, ""))
            self.query_table.setRowCount(0)
            self.query_table.setColumnCount(0)
            self.query_raw.setText("")
        self.current_container = c

        # Document and key-value stores have no column structure to show
        has_structure = c.engine not in ("mongodb", "redis")
        if not has_structure and self.tabs.currentIndex() == 1:
            self.tabs.setCurrentIndex(0)
        self.tabs.setTabVisible(1, has_structure)

        if not c.running:
            self._clear_tree()
            self._clear_grids()
            self.status_bar.showMessage(f"{c.name} is stopped")
            return

        self.schema_tree.blockSignals(True)
        self._clear_tree()
        self.schema_tree.blockSignals(False)

        def _task():
            return self.backend.list_databases_and_items(c)

        def _done(res):
            if self.current_container is not c:
                return
            active_db, dbs, items, summary = res
            self.current_db = active_db
            self.current_items = items
            self._build_schema_tree(c, dbs, active_db, items)
            self.status_bar.showMessage(f"Connected to {c.name}  •  {summary}  •  {c.connection_url}")

        self._run_async(f"Connecting to {c.name} ({c.engine_label})...", _task, _done, channel="schema")

    # -----------------------------------------------------------------------
    # Schema tree: databases → tables / keys / collections
    # -----------------------------------------------------------------------

    _ROLE = Qt.ItemDataRole.UserRole

    def _table_node(self, db: str, it: Dict[str, str]) -> QTreeWidgetItem:
        # Counts and sizes live in the database overview, the tree stays just names
        node = QTreeWidgetItem([f"󰓫  {it.get('name', '')}"])
        node.setData(0, self._ROLE, ("table", db, it.get("name", "")))
        return node

    def _fill_db_node(self, node: QTreeWidgetItem, db: str, items: List[Dict[str, str]]):
        tree = self.schema_tree
        cur = tree.currentItem()
        selected = None
        if cur is not None and cur.parent() is node:
            selected = (cur.data(0, self._ROLE) or ("", "", ""))[2]
        # Rebuilding children must not bounce the selection around
        was_blocked = tree.blockSignals(True)
        node.takeChildren()
        for it in items:
            node.addChild(self._table_node(db, it))
        if not items:
            empty = QTreeWidgetItem(["No tables"])
            empty.setFlags(Qt.ItemFlag.NoItemFlags)
            empty.setData(0, self._ROLE, ("empty", db, ""))
            node.addChild(empty)
        node.setData(0, self._ROLE, ("db", db, "loaded"))
        self._db_items[db] = items
        again = next((node.child(i) for i in range(node.childCount())
                      if selected and (node.child(i).data(0, self._ROLE) or ("", "", ""))[2] == selected), None)
        if selected is not None:
            tree.setCurrentItem(again or node)
        tree.blockSignals(was_blocked)
        if again is not None:
            if self.current_table == selected and self.current_db == db:
                self._table_load_timer.start()  # show the table's fresh rows
        elif tree.currentItem() is node:
            self._show_db_overview(db)

    def _set_grid(self, headers: List[str], rows: List[List[str]], overview: str = ""):
        """Show rows in the data grid. Copy JSON/CSV and Enter/double-click follow this state."""
        self.current_headers = headers
        self.current_rows = rows
        self._grid_overview = overview
        self._fill_table_widget(self.data_table, headers, rows)
        self.filter_loaded_rows()

    def _clear_grids(self):
        self._set_grid([], [])
        self.struct_table.setRowCount(0)
        self.struct_table.setColumnCount(0)

    def _overview_headers(self) -> List[str]:
        engine = self.current_container.engine if self.current_container else ""
        if engine == "redis":
            return ["Key", "Type", "TTL"]
        if engine == "mongodb":
            return ["Collection", "Documents", "Kind"]
        if engine == "sqlite":
            return ["Table", "Rows", "Type"]
        return ["Table", "Rows", "Size"]

    def _show_db_overview(self, db: str):
        """List a database's tables in the data grid; open one with Enter or double-click."""
        items = self._db_items.get(db)
        self.current_db = db
        self.current_table = ""
        self._table_load_timer.stop()
        self._clear_grids()
        self._grid_overview = db
        if items is None:
            # Not loaded yet: fetch it; _fill_db_node shows the list when it arrives
            tree = self.schema_tree
            for i in range(tree.topLevelItemCount()):
                top = tree.topLevelItem(i)
                if (top.data(0, self._ROLE) or ("", ""))[:2] == ("db", db):
                    self._load_db_node(top)
            return
        headers = self._overview_headers()
        rows = []
        for it in items:
            count = it.get("count", "")
            m = re.match(r"\s*(-?\d[\d.]*(?:[eE][+-]?\d+)?)\b", count)
            rows.append([it.get("name", ""), m.group(1) if m else count, it.get("extra", "")])
        # Drop the third column when it says nothing (MongoDB's "collection", empty extras)
        if headers[2] == "Kind" or all(not r[2] for r in rows):
            headers, rows = headers[:2], [r[:2] for r in rows]
        self._set_grid(headers, rows, overview=db)
        c = self.current_container
        what = "collections" if headers[0] == "Collection" else "keys" if headers[0] == "Key" else "tables"
        self.status_bar.showMessage(f"{c.name if c else ''} → {db}: {len(rows)} {what}")

    def refresh_database(self, db: str):
        """Reload one database's table list in place (tree + overview), keeping the selection."""
        c = self.current_container
        if c is None:
            return
        tree = self.schema_tree
        if c.engine == "sqlite":
            self._refresh_sqlite_file(c)
            return
        for i in range(tree.topLevelItemCount()):
            top = tree.topLevelItem(i)
            data = top.data(0, self._ROLE) or ("", "", "")
            if data[:2] != ("db", db):
                continue
            if data[2] == "loading":
                self._reload_pending.add(db)  # reload once the running load lands
            elif data[2] == "loaded":
                top.setData(0, self._ROLE, ("db", db, ""))
                self._load_db_node(top)

    def _refresh_sqlite_file(self, c: DockerDbContainer):
        gen = self._tree_gen

        def _task():
            return self.backend.list_databases_and_items(c)

        def _done(res):
            if self._tree_gen != gen or self.current_container is not c:
                return
            prev_table = self.current_table
            prev_tab = self.tabs.currentIndex()
            active_db, dbs, items, _ = res
            self._build_schema_tree(c, dbs, active_db, items)
            node = next((n for n in self._table_nodes() if n.data(0, self._ROLE)[2] == prev_table), None)
            if prev_table and node is not None:
                self.schema_tree.setCurrentItem(node)
            self.tabs.setCurrentIndex(prev_tab)

        self._run_async(f"Reloading {c.name}...", _task, _done)

    def refresh_database_list(self):
        """Add databases created and drop ones removed since the tree was built."""
        c = self.current_container
        if c is None or c.engine == "sqlite":
            return
        gen = self._tree_gen

        def _task():
            return self.backend.list_databases_and_items(c, self.current_db)

        def _done(res):
            if self._tree_gen != gen or self.current_container is not c:
                return
            dbs = res[1]
            tree = self.schema_tree
            existing = {}
            for i in range(tree.topLevelItemCount()):
                data = tree.topLevelItem(i).data(0, self._ROLE) or ("", "", "")
                if data[0] == "db":
                    existing[data[1]] = tree.topLevelItem(i)
            for db, node in existing.items():
                if db not in dbs:
                    if tree.currentItem() in (node, *[node.child(j) for j in range(node.childCount())]):
                        tree.setCurrentItem(None)
                    self._db_items.pop(db, None)
                    tree.takeTopLevelItem(tree.indexOfTopLevelItem(node))
            for pos, db in enumerate(dbs):
                if db not in existing:
                    node = QTreeWidgetItem([f"󰆼  {db}"])
                    node.setData(0, self._ROLE, ("db", db, ""))
                    loading = QTreeWidgetItem(["…"])
                    loading.setFlags(Qt.ItemFlag.NoItemFlags)
                    node.addChild(loading)
                    tree.insertTopLevelItem(min(pos, tree.topLevelItemCount()), node)
            self.apply_tree_filter()

        self._run_async(f"Reloading {c.name} databases...", _task, _done)

    def _open_from_overview(self, row: int):
        db = self._grid_overview
        item = self.data_table.item(row, 0)
        if not db or item is None:
            return
        name = item.text()
        for node in self._table_nodes():
            d = node.data(0, self._ROLE)
            if d[1] == db and d[2] == name:
                if node.parent():
                    node.parent().setExpanded(True)
                self.schema_tree.setCurrentItem(node)
                self._open_selected_table()
                return

    def _on_grid_double_click(self, row: int, col: int):
        if self._grid_overview:
            self._open_from_overview(row)
        else:
            self.inspect_cell_dialog(row, col)

    def _clear_tree(self):
        # Any tree items async loads still hold become invalid from here on
        self._tree_gen += 1
        self.schema_tree.clear()

    def _build_schema_tree(self, c: DockerDbContainer, dbs: List[str], active_db: str, items: List[Dict[str, str]]):
        tree = self.schema_tree
        tree.blockSignals(True)
        self._clear_tree()
        self._filter_expanded = []
        self._db_items = {active_db: items}
        self._reload_pending = set()
        self.current_table = ""
        self._clear_grids()
        if c.engine == "sqlite":
            # One file is one database: list its tables directly
            for it in items:
                tree.addTopLevelItem(self._table_node(active_db, it))
        else:
            for db in dbs:
                node = QTreeWidgetItem([f"󰆼  {db}"])
                if db == active_db:
                    self._fill_db_node(node, db, items)
                else:
                    node.setData(0, self._ROLE, ("db", db, ""))
                    loading = QTreeWidgetItem(["…"])
                    loading.setFlags(Qt.ItemFlag.NoItemFlags)
                    node.addChild(loading)
                tree.addTopLevelItem(node)
                if db == active_db:
                    node.setExpanded(True)
        tree.blockSignals(False)
        self.apply_tree_filter()
        if c.engine == "sqlite":
            self._show_db_overview(active_db)

    def on_tree_expanded(self, node: QTreeWidgetItem):
        self._load_db_node(node)

    def _load_db_node(self, node: QTreeWidgetItem):
        data = node.data(0, self._ROLE)
        if not data or data[0] != "db" or data[2] == "loaded" or not self.current_container:
            return
        c = self.current_container
        db = data[1]
        gen = self._tree_gen
        node.setData(0, self._ROLE, ("db", db, "loading"))

        def _task():
            return self.backend.list_databases_and_items(c, db)

        def _current() -> bool:
            # The tree may have been rebuilt meanwhile; its old items are gone
            return self._tree_gen == gen and self.current_container is c

        def _done(res):
            if not _current():
                return
            self._fill_db_node(node, db, res[2])
            self.apply_tree_filter()
            if db in self._reload_pending:
                # A refresh was asked for while this load was already running
                self._reload_pending.discard(db)
                node.setData(0, self._ROLE, ("db", db, ""))
                self._load_db_node(node)

        def _failed(_msg):
            # Let the next expand / click / filter try again
            if _current():
                self._reload_pending.discard(db)
                node.setData(0, self._ROLE, ("db", db, ""))

        self._run_async(f"Loading {c.name}/{db}...", _task, _done, on_error=_failed)

    def _table_nodes(self):
        tree = self.schema_tree
        for i in range(tree.topLevelItemCount()):
            top = tree.topLevelItem(i)
            kind = (top.data(0, self._ROLE) or ("",))[0]
            if kind == "table":
                yield top
            for j in range(top.childCount()):
                child = top.child(j)
                if (child.data(0, self._ROLE) or ("",))[0] == "table":
                    yield child

    def apply_tree_filter(self):
        flt = self.table_filter.text().strip().lower()
        tree = self.schema_tree
        if not flt and self._filter_expanded:
            # Fold back what the filter opened, except where the selection is
            cur = tree.currentItem()
            keep = cur.parent() if cur is not None and cur.parent() is not None else cur
            for node in self._filter_expanded:
                if node is not keep:
                    node.setExpanded(False)
        if not flt:
            self._filter_expanded = []
        if flt:
            # Search every database, not just the ones opened so far
            for i in range(tree.topLevelItemCount()):
                self._load_db_node(tree.topLevelItem(i))
        for i in range(tree.topLevelItemCount()):
            top = tree.topLevelItem(i)
            data = top.data(0, self._ROLE) or ("", "", "")
            if data[0] == "table":
                top.setHidden(bool(flt) and flt not in data[2].lower())
                continue
            db_match = not flt or flt in data[1].lower()
            any_child = False
            for j in range(top.childCount()):
                child = top.child(j)
                cdata = child.data(0, self._ROLE) or ("", "", "")
                visible = db_match or (cdata[0] == "table" and flt in cdata[2].lower())
                child.setHidden(not visible)
                any_child = any_child or (visible and cdata[0] == "table")
            top.setHidden(not (db_match or any_child))
            if flt and any_child and not top.isExpanded():
                top.setExpanded(True)
                self._filter_expanded.append(top)

        cur = tree.currentItem()
        cur_kind = (cur.data(0, self._ROLE) or ("",))[0] if cur else ""
        if flt and (cur is None or cur.isHidden() or (cur.parent() and cur.parent().isHidden()) or cur_kind != "table"):
            # While filtering, highlight the first match so Enter opens it
            first = next((n for n in self._table_nodes() if not n.isHidden() and not (n.parent() and n.parent().isHidden())), None)
            if first is not None:
                tree.setCurrentItem(first)
        elif not flt and (cur is None or cur.isHidden()):
            # Otherwise just point at the open database; no table is loaded until chosen
            for i in range(tree.topLevelItemCount()):
                top = tree.topLevelItem(i)
                if (top.data(0, self._ROLE) or ("",))[0] == "db" and top.isExpanded():
                    tree.blockSignals(True)
                    tree.setCurrentItem(top)
                    tree.blockSignals(False)
                    self._show_db_overview(top.data(0, self._ROLE)[1])
                    break

    def on_tree_current_changed(self, cur: QTreeWidgetItem, _prev=None):
        if cur is None:
            return
        data = cur.data(0, self._ROLE)
        if not data:
            return
        kind, db, name = data
        if kind == "db":
            self._show_db_overview(db)
            return
        if kind != "table":
            return
        self.current_db = db
        self.current_table = name
        self._grid_overview = ""
        # Wait for typing / arrow-key runs to settle before querying
        self._table_load_timer.start()

    # -----------------------------------------------------------------------
    # Keyboard navigation: containers → tables (type to filter) → data grid
    # -----------------------------------------------------------------------

    def eventFilter(self, obj, event):
        if event.type() != QEvent.Type.KeyPress:
            return super().eventFilter(obj, event)
        key = event.key()
        mods = event.modifiers() & ~Qt.KeyboardModifier.KeypadModifier
        plain = mods in (Qt.KeyboardModifier.NoModifier, Qt.KeyboardModifier.ShiftModifier)
        enter = key in (Qt.Key.Key_Return, Qt.Key.Key_Enter)

        if obj is self.container_list:
            if enter or key == Qt.Key.Key_Right:
                self._focus_tables()
                return True

        elif obj is self.schema_tree:
            cur = self.schema_tree.currentItem()
            kind = (cur.data(0, self._ROLE) or ("",))[0] if cur else ""
            if enter:
                if kind == "db":
                    cur.setExpanded(not cur.isExpanded())
                else:
                    self._open_selected_table()
                return True
            if key == Qt.Key.Key_Right and kind == "table":
                self._open_selected_table()
                return True
            at_top = cur is None or (cur.parent() is None and not cur.isExpanded())
            if key == Qt.Key.Key_Escape or (key == Qt.Key.Key_Left and at_top):
                if key == Qt.Key.Key_Escape and self.table_filter.text():
                    self.table_filter.clear()
                elif not self.sqlite_path:
                    self.container_list.setFocus()
                return True
            if key == Qt.Key.Key_Backspace:
                self.table_filter.backspace()
                return True
            text = event.text()
            if plain and text and text.isprintable() and not text.isspace() and text != "/":
                self.table_filter.insert(text)
                return True

        elif obj is self.table_filter:
            if key in (Qt.Key.Key_Down, Qt.Key.Key_Up):
                self.schema_tree.setFocus()
                return True
            if enter:
                self._open_selected_table()
                return True
            if key == Qt.Key.Key_Escape:
                if self.table_filter.text():
                    self.table_filter.clear()
                else:
                    self.schema_tree.setFocus()
                return True

        elif obj is self.data_table:
            if enter and self._grid_overview:
                row = self.data_table.currentRow()
                if row < 0 or self.data_table.isRowHidden(row):
                    row = next((r for r in range(self.data_table.rowCount()) if not self.data_table.isRowHidden(r)), -1)
                if row >= 0:
                    self._open_from_overview(row)
                return True
            if key == Qt.Key.Key_Escape:
                self.schema_tree.setFocus()
                return True

        return super().eventFilter(obj, event)

    def _focus_tables(self):
        self.schema_tree.setFocus()
        if self.schema_tree.currentItem() is None:
            first = next(self._table_nodes(), None)
            if first is not None:
                self.schema_tree.setCurrentItem(first)

    def _open_selected_table(self):
        cur = self.schema_tree.currentItem()
        if cur is None or (cur.data(0, self._ROLE) or ("",))[0] != "table":
            first = next((n for n in self._table_nodes() if not n.isHidden()), None)
            if first is None:
                return
            self.schema_tree.setCurrentItem(first)
        if self._table_load_timer.isActive():
            self._table_load_timer.stop()
            self.reload_current_table()
        self.tabs.setCurrentIndex(0)
        self.data_table.setFocus()
        if self.data_table.rowCount() and self.data_table.currentRow() < 0:
            self.data_table.setCurrentCell(0, 0)

    def reload_current_table(self):
        if self._grid_overview and self.current_container:
            self.refresh_database(self._grid_overview)
            return
        if not self.current_container or not self.current_table:
            return
        c = self.current_container
        db_name = self.current_db
        tbl_name = self.current_table
        limit = int(self.limit_combo.currentText() or "100")

        def _task():
            headers, rows, _ = self.backend.fetch_table_rows(c, db_name, tbl_name, limit=limit)
            s_headers, s_rows, _ = self.backend.fetch_table_structure(c, db_name, tbl_name)
            return headers, rows, s_headers, s_rows

        def _done(res):
            if self.current_table != tbl_name or self.current_container is not c:
                return  # the user moved on while this was loading
            headers, rows, s_headers, s_rows = res
            self._set_grid(headers, rows)
            self._fill_table_widget(self.struct_table, s_headers, s_rows)
            self.status_bar.showMessage(
                f"{c.name} → {db_name}.{tbl_name}: loaded {len(rows)} row(s)"
            )

        self._run_async(f"Loading {db_name}.{tbl_name} (limit {limit})...", _task, _done, channel="table")

    @staticmethod
    def _fill_table_widget(widget: QTableWidget, headers: List[str], rows: List[List[str]]):
        widget.setSortingEnabled(False)
        widget.clear()
        widget.setColumnCount(len(headers))
        widget.setHorizontalHeaderLabels(headers)
        widget.setRowCount(len(rows))

        for r_idx, row in enumerate(rows):
            for c_idx, val in enumerate(row):
                if c_idx >= len(headers):
                    break
                cell = QTableWidgetItem(val)
                cell.setFlags(cell.flags() & ~Qt.ItemFlag.ItemIsEditable)
                widget.setItem(r_idx, c_idx, cell)

        widget.horizontalHeader().setSectionResizeMode(QHeaderView.ResizeMode.Interactive)
        widget.resizeColumnsToContents()
        for c_idx in range(len(headers)):
            if widget.columnWidth(c_idx) > 360:
                widget.setColumnWidth(c_idx, 360)
        widget.setSortingEnabled(True)

    def filter_loaded_rows(self):
        needle = self.row_search.text().strip().lower()
        for r in range(self.data_table.rowCount()):
            if not needle:
                self.data_table.setRowHidden(r, False)
                continue
            matched = False
            for c in range(self.data_table.columnCount()):
                item = self.data_table.item(r, c)
                if item and needle in item.text().lower():
                    matched = True
                    break
            self.data_table.setRowHidden(r, not matched)

    def run_custom_query(self):
        if not self.current_container or not self.current_container.running:
            return
        q = self.query_editor.toPlainText().strip()
        if not q:
            return
        self.tabs.setCurrentIndex(2)
        c = self.current_container
        db_name = self.current_db
        wrote = is_write_query(c.engine, q)
        if wrote and not self._confirm_write_query(c, db_name, q):
            return

        def _task():
            t0 = time.monotonic()
            res = self.backend.execute_query(c, db_name, q)
            return res, (time.monotonic() - t0) * 1000

        def _done(res):
            if self.current_container is not c:
                return
            (headers, rows, raw), elapsed_ms = res
            if headers == ["Error"]:
                self.query_table.setRowCount(0)
                self.query_table.setColumnCount(0)
            else:
                self._fill_table_widget(self.query_table, headers, rows)
            elapsed = f"{elapsed_ms:.0f} ms" if elapsed_ms >= 10 else f"{elapsed_ms:.1f} ms"
            # Below the grid: only the outcome, never the result rows again
            self.query_raw.setStyleSheet(f"color: {self.theme['muted']}; padding: 2px 4px;")
            if headers == ["Error"]:
                message = (rows[0][0] if rows and rows[0] else raw).strip() or "Query failed"
                message = re.sub(r"^(ERROR|Error|error):\s*", "", message)
                self.query_raw.setText(f"Error: {message}")
                self.query_raw.setStyleSheet(f"color: {self.theme['red']}; padding: 2px 4px;")
                self.status_bar.clearMessage()
            elif headers in (["Status"], ["Result"]):
                message = rows[0][0] if rows and rows[0] else "Query OK"
                message = re.sub(r"\s*\([\d.]+ ms\)$", "", message)
                self.query_raw.setText(f"{message}  •  {elapsed}")
                self.status_bar.clearMessage()
            else:
                self.query_raw.setText(f"{len(rows)} row(s)  •  {elapsed}")
                self.status_bar.clearMessage()
            if wrote and headers != ["Error"]:
                # Tables (or whole databases) may have been created, dropped or resized
                self.refresh_database_list()
                self.refresh_database(db_name)

        self._run_async(f"Executing query on {c.name}/{db_name}...", _task, _done, channel="query")

    def _switcher_entries(self) -> List[Tuple[str, Any]]:
        entries: List[Tuple[str, Any]] = []
        tree = self.schema_tree
        cur = self.current_container
        for i in range(tree.topLevelItemCount()):
            top = tree.topLevelItem(i)
            data = top.data(0, self._ROLE) or ("", "", "")
            if data[0] == "table":
                entries.append((f"󰓫  {data[2]}", ("table", data[1], data[2])))
                continue
            for j in range(top.childCount()):
                cd = top.child(j).data(0, self._ROLE) or ("", "", "")
                if cd[0] == "table":
                    entries.append((f"󰓫  {cd[1]} › {cd[2]}", ("table", cd[1], cd[2])))
            entries.append((f"󰆼  {data[1]}", ("db", data[1], "")))
        if not self.sqlite_path:
            for c in self.containers:
                if c is not cur:
                    entries.append((f"  {c.name}  ·  {c.engine_label} {c.version}".rstrip(), ("container", c.name, "")))
        return entries

    def open_quick_switcher(self):
        # Make every database's tables searchable, not only the opened ones
        for i in range(self.schema_tree.topLevelItemCount()):
            self._load_db_node(self.schema_tree.topLevelItem(i))
        QuickSwitcher(self, self._switcher_entries, self._quick_switch_to).exec()

    def _quick_switch_to(self, key):
        self.activateWindow()
        kind, name, table = key
        tree = self.schema_tree
        if kind == "container":
            row = [c.name for c in self.containers].index(name)
            self.container_list.setCurrentRow(row)
            self._focus_tables()
            return
        for i in range(tree.topLevelItemCount()):
            top = tree.topLevelItem(i)
            data = top.data(0, self._ROLE) or ("", "", "")
            if kind == "db" and data[0] == "db" and data[1] == name:
                top.setExpanded(True)
                tree.setCurrentItem(top)
                tree.setFocus()
                return
            nodes = [top] if data[0] == "table" else [top.child(j) for j in range(top.childCount())]
            for node in nodes:
                nd = node.data(0, self._ROLE) or ("", "", "")
                if nd[0] == "table" and nd[1] == name and nd[2] == table:
                    if node.parent():
                        node.parent().setExpanded(True)
                    self.table_filter.clear()
                    tree.setCurrentItem(node)
                    self._open_selected_table()
                    return

    def _confirm_write_query(self, c: DockerDbContainer, db_name: str, query: str) -> bool:
        dlg = QDialog(self)
        dlg.setWindowTitle("Run query?")
        dlg.resize(620, 360)
        layout = QVBoxLayout(dlg)
        target = f"{c.name} / {db_name}" if db_name and db_name != c.name else c.name
        msg = QLabel(f"This query can change data in <b>{target}</b>:")
        msg.setWordWrap(True)
        layout.addWidget(msg)
        shown = QPlainTextEdit(query)
        shown.setReadOnly(True)
        layout.addWidget(shown, 1)
        btn_row = QHBoxLayout()
        btn_row.addStretch(1)
        btn_cancel = QPushButton("Cancel")
        btn_cancel.clicked.connect(dlg.reject)
        btn_run = QPushButton("Run")
        btn_run.setObjectName("dangerBtn")
        btn_run.clicked.connect(dlg.accept)
        btn_row.addWidget(btn_cancel)
        btn_row.addWidget(btn_run)
        layout.addLayout(btn_row)
        btn_cancel.setDefault(True)
        btn_cancel.setFocus()
        return dlg.exec() == QDialog.DialogCode.Accepted

    def show_container_menu(self, pos):
        menu = QMenu(self)
        c = self.current_container
        if self.sqlite_path:
            menu.addAction("Copy Path", lambda: QGuiApplication.clipboard().setText(c.default_db) if c else None)
            menu.addAction("Open in sqlite3\tCtrl+T", self.open_terminal_shell)
            menu.addAction("Reload\tCtrl+R", self.refresh_containers)
            menu.exec(self.container_list.viewport().mapToGlobal(pos))
            return
        if c:
            menu.addAction("Stop Container" if c.running else "Start Container", self.toggle_selected_container)
            menu.addAction("Copy DSN / URL\tCtrl+Shift+C", self.copy_connection_url)
            act_cli = menu.addAction("Terminal Shell\tCtrl+T", self.open_terminal_shell)
            act_cli.setEnabled(c.running)
            menu.addSeparator()
        menu.addAction("Rescan Docker\tCtrl+R", self.refresh_containers)
        menu.addAction("Install DB…", self.launch_omarchy_install_db)
        menu.exec(self.container_list.viewport().mapToGlobal(pos))

    def toggle_selected_container(self):
        if not self.current_container:
            return
        c = self.current_container
        action = "Stopping" if c.running else "Starting"

        def _task():
            return self.backend.toggle_container(c)

        def _done(res):
            ok, msg = res
            if not ok and msg:
                QMessageBox.warning(self, "Docker Error", msg)
            self.refresh_containers()

        self._run_async(f"{action} container {c.name}...", _task, _done, channel="toggle")

    def copy_connection_url(self):
        if not self.current_container:
            return
        url = self.current_container.connection_url
        QGuiApplication.clipboard().setText(url)
        self.status_bar.showMessage(f"Copied connection URL to clipboard: {url}")

    def copy_table_as_json(self):
        if not self.current_headers or not self.current_rows:
            return
        records = []
        for r in self.current_rows:
            obj = {
                self.current_headers[i]: (r[i] if i < len(r) else None)
                for i in range(len(self.current_headers))
            }
            records.append(obj)
        text = json.dumps(records, indent=2, ensure_ascii=False)
        QGuiApplication.clipboard().setText(text)
        self.status_bar.showMessage(f"Copied {len(records)} rows as JSON to clipboard.")

    def copy_table_as_csv(self):
        if not self.current_headers:
            return
        buf = io.StringIO()
        writer = csv.writer(buf)
        writer.writerow(self.current_headers)
        writer.writerows(self.current_rows)
        QGuiApplication.clipboard().setText(buf.getvalue())
        self.status_bar.showMessage(f"Copied {len(self.current_rows)} rows as CSV to clipboard.")

    def open_terminal_shell(self):
        if not self.current_container or not self.current_container.running:
            return
        self.backend.open_interactive_terminal(self.current_container, self.current_db)

    def launch_omarchy_install_db(self):
        subprocess.Popen(
            ["omarchy-launch-floating-terminal-with-presentation", "omarchy-install-docker-dbs"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )

    def _show_cell_inspector(self, col_name: str, value: str):
        dlg = QDialog(self)
        dlg.setWindowTitle(col_name)
        dlg.resize(640, 420)
        layout = QVBoxLayout(dlg)
        editor = QPlainTextEdit()
        editor.setReadOnly(True)
        # Pretty-print JSON if valid
        formatted = value
        if value.strip().startswith(("{", "[")):
            try:
                formatted = json.dumps(json.loads(value), indent=2, ensure_ascii=False)
            except Exception:
                pass
        editor.setPlainText(formatted)
        layout.addWidget(editor)

        btn_row = QHBoxLayout()
        btn_copy = QPushButton("󰆏  Copy")
        btn_copy.clicked.connect(lambda: (QGuiApplication.clipboard().setText(formatted), dlg.accept()))
        btn_close = QPushButton("Close")
        btn_close.clicked.connect(dlg.accept)
        btn_row.addStretch(1)
        btn_row.addWidget(btn_copy)
        btn_row.addWidget(btn_close)
        layout.addLayout(btn_row)
        dlg.exec()

    def inspect_cell_dialog(self, row: int, col: int):
        item = self.data_table.item(row, col)
        hdr = self.data_table.horizontalHeaderItem(col)
        if item:
            self._show_cell_inspector(hdr.text() if hdr else f"Col {col}", item.text())

    def inspect_query_cell_dialog(self, row: int, col: int):
        item = self.query_table.item(row, col)
        hdr = self.query_table.horizontalHeaderItem(col)
        if item:
            self._show_cell_inspector(hdr.text() if hdr else f"Col {col}", item.text())


def main():
    app = QApplication(sys.argv)
    app.setApplicationName("omatable")
    app.setDesktopFileName("omatable")
    local_icon = os.path.join(os.path.dirname(os.path.realpath(__file__)), "omatable.svg")
    fallback_icon = QIcon(local_icon) if os.path.exists(local_icon) else QIcon()
    app.setWindowIcon(QIcon.fromTheme("omatable", fallback_icon))
    arg = sys.argv[1] if len(sys.argv) > 1 and not sys.argv[1].startswith("-") else ""
    if arg.startswith("file://"):
        from urllib.parse import unquote, urlparse
        arg = unquote(urlparse(arg).path)
    if arg and os.path.isfile(arg):
        win = OmatableWindow(sqlite_path=arg)
    else:
        win = OmatableWindow(initial_container=arg)
    win.show()
    sys.exit(app.exec())


if __name__ == "__main__":
    main()
