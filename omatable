def fuzzy_score(query: str, text: str) -> Optional[int]:
    """Lower is better; None when the query's letters don't appear in order."""
    q, t = query.lower(), text.lower()
    if not q:
        return 0
    pos = t.find(q)
    if pos >= 0:
        return pos  # plain substring matches win, earlier is better
    i, gaps, last = 0, 0, -1
    for j, ch in enumerate(t):
        if i < len(q) and ch == q[i]:
            if last >= 0:
                gaps += j - last - 1
            last = j
            i += 1
    return 1000 + gaps if i == len(q) else None


class QuickSwitcher(QDialog):
    """Ctrl+P: type to jump to a container, database or table."""

    def __init__(self, parent, entries: Callable[[], List[Tuple[str, Any]]], on_pick: Callable[[Any], None]):
        super().__init__(parent)
        self.setWindowTitle("Go to")
        self.resize(560, 420)
        self._entries = entries
        self._on_pick = on_pick
        self._shown: List[Any] = []

        layout = QVBoxLayout(self)
        layout.setContentsMargins(10, 10, 10, 10)
        layout.setSpacing(8)
        self.search = QLineEdit()
        self.search.setPlaceholderText("Go to container, database or table")
        self.search.textChanged.connect(self.refresh)
        self.search.installEventFilter(self)
        layout.addWidget(self.search)
        self.results = QListWidget()
        self.results.itemActivated.connect(lambda _: self.pick())
        layout.addWidget(self.results, 1)

        # Tables of other databases arrive in the background; keep the list fresh
        self._poll = QTimer(self)
        self._poll.setInterval(400)
        self._poll.timeout.connect(self._refresh_if_changed)
        self._poll.start()
        self._last_count = -1
        self.refresh()

    def _refresh_if_changed(self):
        if len(self._entries()) != self._last_count:
            self.refresh()

    def refresh(self):
        query = self.search.text().strip()
        entries = self._entries()
        self._last_count = len(entries)
        scored = []
        for order, (label, key) in enumerate(entries):
            score = fuzzy_score(query, label)
            if score is not None:
                scored.append((score, order, label, key))
        scored.sort()
        self.results.clear()
        self._shown = []
        for _, _, label, key in scored[:200]:
            self.results.addItem(label)
            self._shown.append(key)
        if self._shown:
            self.results.setCurrentRow(0)

    def eventFilter(self, obj, event):
        if obj is self.search and event.type() == QEvent.Type.KeyPress:
            key = event.key()
            row = self.results.currentRow()
            if key == Qt.Key.Key_Down:
                self.results.setCurrentRow(min(row + 1, self.results.count() - 1))
                return True
            if key == Qt.Key.Key_Up:
                self.results.setCurrentRow(max(row - 1, 0))
                return True
            if key in (Qt.Key.Key_Return, Qt.Key.Key_Enter):
                self.pick()
                return True
        return super().eventFilter(obj, event)

    def pick(self):
        row = self.results.currentRow()
        if 0 <= row < len(self._shown):
            key = self._shown[row]
            self.accept()
            # Run after the dialog has handed focus back, so the jump keeps focus
            QTimer.singleShot(0, lambda: self._on_pick(key))


